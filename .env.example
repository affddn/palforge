# Server inventory as one line of JSON. Each entry: name, the SSH host alias that
# reaches the VPS, the Docker container running Palworld, and the world GUID.
PALFORGE_SERVERS='[{"name":"main","sshHost":"palworld-main","container":"palworld-server","worldGuid":"0123456789ABCDEF0123456789ABCDEF"}]'

# Or point at a JSON file with the same content (used when PALFORGE_SERVERS is unset):
# PALFORGE_SERVERS_FILE=/etc/palforge/servers.json
